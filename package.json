{
  "dependencies": {
    "express": "^4.21.2",
    "undici": "^6.21.1",
    "systray": "^1.0.5"
  },
  "description": "Unified proxy wrapper combining IP rotation and multi-account API key management for OpenCode Zen",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "name": "opencode-max",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "tray": "node dist/index.js --tray",
    "prepare": "npm run build"
  },
  "type": "module",
  "version": "1.0.0",
  "bin": {
    "opencode-max": "./bin/opencode-max.cjs"
  },
  "files": [
    "dist/",
    "bin/",
    "public/",
    "tray/",
    "scripts/",
    "accounts.example.json",
    "proxies.example.json",
    "README.md",
    "ecosystem.config.cjs"
  ]
}